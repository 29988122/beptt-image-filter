<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.beptt.imagefilter" android:versionCode="3" android:versionName="1.0.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35"/>
    <application android:label="BePTT 圖片網址黑名單"
        android:description="@string/module_description"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".SettingsActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <provider android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="net.beptt.imagefilter.XposedService" android:exported="true"/>
    </application>
</manifest>
